        -annotation "HardenAllEdges: Makes every edge of every polygon object have hard polygonal normal shading\n(unlocks the normals first: can be turned off with the Options button)"
        -enableBackground 0
        -backgroundColor 0 0 0
        -highlightColor 0.321569 0.521569 0.65098
        -align "center"
        -label "HardenAllEdges"
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont"
        -imageOverlayLabel "HardenAllEdges"
        -overlayLabelColor 0.8 0.8 0.8
        -overlayLabelBackColor 0 0 0 0.5
        -image "polyHardEdge.png"
        -image1 "polyHardEdge.png"
        -style "iconOnly"
        -marginWidth 1
        -marginHeight 1
        -command "global proc int ModelUtilities_HardenAllEdges()\n{\n    // unlock the normals first (imported models often have locked normals, which polySoftEdge can't change)\n    int $unlock = 1;\n    if (`optionVar -exists \"ModelUtilities_unlockNormals\"`)\n        $unlock = `optionVar -query \"ModelUtilities_unlockNormals\"`;\n    // which objects to change: \"all\" (the whole scene) or \"selected\" (only the selected objects),\n    // set with the Options button\n    string $affect = \"all\";\n    if (`optionVar -exists \"ModelUtilities_affect\"`)\n        $affect = `optionVar -query \"ModelUtilities_affect\"`;\n    string $where = \"\";\n    if ($affect == \"selected\")\n        $where = \" (selected objects only)\";\n    // the meshes to change: all of them in the scene, or the selected ones\n    string $meshes[];\n    if ($affect == \"selected\")\n    {\n        string $selection[] = `ls -selection -objectsOnly`;\n        if (size($selection))\n            $meshes = `ls -long -dag -noIntermediate -type \"mesh\" $selection`;\n    }\n    else\n        $meshes = `ls -long -noIntermediate -type \"mesh\"`;\n    $meshes = stringArrayRemoveDuplicates($meshes);\n    if (size($meshes) == 0)\n    {\n        warning (\"HardenAllEdges: no meshes found\" + $where);\n        return 0;\n    }\n    string $mesh;\n    for ($mesh in $meshes)\n    {\n        int $edges[] = `polyEvaluate -edge $mesh`;\n        if ($edges[0] == 0)\n            continue;\n        if ($unlock)\n            polyNormalPerVertex -unFreezeNormal true ($mesh + \".vtx[*]\");\n        polySoftEdge -angle 0 -constructionHistory 1 ($mesh + \".e[*]\");\n    }\n    print (\"HardenAllEdges: \" + size($meshes) + \" meshes hardened\" + $where + \"\\n\");\n    return size($meshes);\n}\nundoInfo -openChunk;\ncatch(ModelUtilities_HardenAllEdges());\nundoInfo -closeChunk;"
