global proc shelf_Utilities () {
    global string $gBuffStr;
    global string $gBuffStr0;
    global string $gBuffStr1;


    shelfButton
        -enableCommandRepeat 1
        -enable 1
        -width 35
        -height 35
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "Options: Opens the Model Utilities options window: which objects the scripts change (the whole scene,\nor only the selected objects), and the settings of the scripts that have some.\nThe settings are saved in the Maya preferences (optionVar), so they are kept between sessions."
        -enableBackground 0
        -backgroundColor 0 0 0
        -highlightColor 0.321569 0.521569 0.65098
        -align "center"
        -label "Options"
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont"
        -imageOverlayLabel "Options"
        -overlayLabelColor 0.8 0.8 0.8
        -overlayLabelBackColor 0 0 0 0.5
        -image "commandButton.png"
        -image1 "commandButton.png"
        -style "iconOnly"
        -marginWidth 1
        -marginHeight 1
        -command "global proc ModelUtilities_Options()\n{\n    // current settings\n    string $affect = \"all\";\n    if (`optionVar -exists \"ModelUtilities_affect\"`)\n        $affect = `optionVar -query \"ModelUtilities_affect\"`;\n    int $filterType = 3;\n    if (`optionVar -exists \"ModelUtilities_filterType\"`)\n        $filterType = `optionVar -query \"ModelUtilities_filterType\"`;\n    if ($filterType < 1 || $filterType > 5)\n        $filterType = 3;\n    float $distance = 0.001;\n    if (`optionVar -exists \"ModelUtilities_mergeDistance\"`)\n        $distance = `optionVar -query \"ModelUtilities_mergeDistance\"`;\n    int $unlock = 1;\n    if (`optionVar -exists \"ModelUtilities_unlockNormals\"`)\n        $unlock = `optionVar -query \"ModelUtilities_unlockNormals\"`;\n    int $perFace = 0;\n    if (`optionVar -exists \"ModelUtilities_billboardPerFace\"`)\n        $perFace = `optionVar -query \"ModelUtilities_billboardPerFace\"`;\n    string $camera = \"persp\";\n    if (`optionVar -exists \"ModelUtilities_billboardCamera\"`)\n        $camera = `optionVar -query \"ModelUtilities_billboardCamera\"`;\n\n    string $window = \"ModelUtilitiesOptions\";\n    if (`window -exists $window`)\n        deleteUI $window;\n    window -title \"Model Utilities Options\" -resizeToFitChildren true $window;\n    columnLayout -adjustableColumn true -rowSpacing 6 -columnAttach \"both\" 8;\n\n    text -label \"\" -height 2;\n    int $affectIndex = 1;\n    if ($affect == \"selected\")\n        $affectIndex = 2;\n    radioButtonGrp -label \"Affect\" -numberOfRadioButtons 2\n        -labelArray2 \"Whole scene\" \"Selected objects\" -select $affectIndex\n        -annotation \"Which objects (and their materials and textures) the scripts change\"\n        -onCommand1 \"optionVar -stringValue \\\"ModelUtilities_affect\\\" \\\"all\\\"\"\n        -onCommand2 \"optionVar -stringValue \\\"ModelUtilities_affect\\\" \\\"selected\\\"\"\n        ModelUtilitiesOptions_affect;\n\n    separator -style \"in\";\n    optionMenuGrp -label \"FilterAllTextures\"\n        -annotation \"The texture filtering set by FilterAllTextures (UnfilterAllTextures sets 'Off')\"\n        -changeCommand \"optionVar -intValue \\\"ModelUtilities_filterType\\\" `optionMenuGrp -query -select ModelUtilitiesOptions_filter`\"\n        ModelUtilitiesOptions_filter;\n        menuItem -label \"Mipmap\";\n        menuItem -label \"Box\";\n        menuItem -label \"Quadratic\";\n        menuItem -label \"Quartic\";\n        menuItem -label \"Gaussian\";\n    optionMenuGrp -edit -select $filterType ModelUtilitiesOptions_filter;\n\n    floatFieldGrp -label \"MergeAllVertices\" -extraLabel \"distance\" -numberOfFields 1 -precision 4\n        -value1 $distance\n        -annotation \"Vertices closer than this distance are merged together\"\n        -changeCommand \"optionVar -floatValue \\\"ModelUtilities_mergeDistance\\\" `floatFieldGrp -query -value1 ModelUtilitiesOptions_distance`\"\n        ModelUtilitiesOptions_distance;\n\n    checkBoxGrp -label \"Soften / Harden\" -numberOfCheckBoxes 1 -label1 \"Unlock normals first\"\n        -value1 $unlock\n        -annotation \"Imported models often have locked normals, on which SoftenAllEdges / HardenAllEdges have no effect\"\n        -changeCommand \"optionVar -intValue \\\"ModelUtilities_unlockNormals\\\" `checkBoxGrp -query -value1 ModelUtilitiesOptions_unlock`\"\n        ModelUtilitiesOptions_unlock;\n\n    separator -style \"in\";\n    radioButtonGrp -label \"FaceCameraAlways\" -numberOfRadioButtons 2\n        -labelArray2 \"Per connected faces\" \"Per face\" -select (1 + $perFace)\n        -annotation \"Make one billboard per group of connected faces (e.g. a quad made of 2 triangles), or one per face\"\n        -onCommand1 \"optionVar -intValue \\\"ModelUtilities_billboardPerFace\\\" 0\"\n        -onCommand2 \"optionVar -intValue \\\"ModelUtilities_billboardPerFace\\\" 1\"\n        ModelUtilitiesOptions_perFace;\n    optionMenuGrp -label \"Aim at camera\"\n        -annotation \"The camera the billboards made by FaceCameraAlways always face\"\n        -changeCommand \"optionVar -stringValue \\\"ModelUtilities_billboardCamera\\\" `optionMenuGrp -query -value ModelUtilitiesOptions_camera`\"\n        ModelUtilitiesOptions_camera;\n    string $cameraShapes[] = `ls -type \"camera\"`;\n    string $cameras[] = `listRelatives -parent $cameraShapes`;\n    string $item;\n    for ($item in $cameras)\n        menuItem -label $item;\n    if (stringArrayContains($camera, $cameras))\n        optionMenuGrp -edit -value $camera ModelUtilitiesOptions_camera;\n\n    separator -style \"in\";\n    button -label \"Close\" -command (\"deleteUI \" + $window);\n    showWindow $window;\n}\nModelUtilities_Options();"
        -sourceType "mel"
        -commandRepeatable 1
        -flat 1
    ;
    separator
        -enable 1
        -width 12
        -height 35
        -manage 1
        -visible 1
        -preventOverride 0
        -enableBackground 0
        -backgroundColor 0 0 0
        -highlightColor 0.321569 0.521569 0.65098
        -style "shelf"
        -horizontal 0
    ;
    shelfButton
        -enableCommandRepeat 1
        -enable 1
        -width 35
        -height 35
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "AlphaNodeCorrect: Plugs the transparency of each material's texture (from its alpha channel) into the material's transparency.\nUse this if the parts of the model which should be transparent appear opaque."
        -enableBackground 0
        -backgroundColor 0 0 0
        -highlightColor 0.321569 0.521569 0.65098
        -align "center"
        -label "AlphaNodeCorrect"
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont"
        -imageOverlayLabel "AlphaNodeCorrect"
        -overlayLabelColor 0.8 0.8 0.8
        -overlayLabelBackColor 0 0 0 0.5
        -image "commandButton.png"
        -image1 "commandButton.png"
        -style "iconOnly"
        -marginWidth 1
        -marginHeight 1
        -command "global proc int ModelUtilities_AlphaNodeCorrect()\n{\n    // which objects to change: \"all\" (the whole scene) or \"selected\" (only the selected objects),\n    // set with the Options button\n    string $affect = \"all\";\n    if (`optionVar -exists \"ModelUtilities_affect\"`)\n        $affect = `optionVar -query \"ModelUtilities_affect\"`;\n    string $where = \"\";\n    if ($affect == \"selected\")\n        $where = \" (selected objects only)\";\n    // the materials to change: every lambert-type material (lambert, phong, blinn...) of the scene,\n    // or only the ones assigned to the selected objects. Maya's default material \"lambert1\" is left alone.\n    string $materials[];\n    if ($affect == \"selected\")\n    {\n        string $selection[] = `ls -selection -objectsOnly`;\n        string $shapes[];\n        if (size($selection))\n            $shapes = `ls -dag -noIntermediate -type \"mesh\" $selection`;\n        string $shape;\n        for ($shape in $shapes)\n        {\n            string $shadingGroups[] = `listConnections -type \"shadingEngine\" $shape`;\n            string $shadingGroup;\n            for ($shadingGroup in $shadingGroups)\n            {\n                string $shaders[] = `listConnections -source true -destination false ($shadingGroup + \".surfaceShader\")`;\n                $materials = stringArrayCatenate($materials, $shaders);\n            }\n        }\n        if (size($materials))\n            $materials = `ls -type \"lambert\" $materials`;\n    }\n    else\n        $materials = `ls -type \"lambert\"`;\n    $materials = stringArrayRemoveDuplicates($materials);\n    $materials = stringArrayRemove({\"lambert1\"}, $materials);\n    if (size($materials) == 0)\n    {\n        warning (\"AlphaNodeCorrect: no materials found\" + $where);\n        return 0;\n    }\n    int $count = 0;\n    string $material;\n    for ($material in $materials)\n    {\n        // the texture plugged into the material's color, or else the first texture of its network\n        string $textures[] = `listConnections -source true -destination false -type \"file\" ($material + \".color\")`;\n        if (size($textures) == 0)\n        {\n            string $history[] = `listHistory $material`;\n            $textures = `ls -type \"file\" $history`;\n        }\n        if (size($textures) == 0)\n            continue;\n        string $texture = $textures[0];\n        // undo the alpha inversion done by the previous version of this script (alphaGain -1, alphaOffset 1),\n        // since outTransparency already is (1 - alpha)\n        if (`getAttr ($texture + \".alphaGain\")` == -1 && `getAttr ($texture + \".alphaOffset\")` == 1)\n        {\n            setAttr ($texture + \".alphaGain\") 1;\n            setAttr ($texture + \".alphaOffset\") 0;\n        }\n        connectAttr -force ($texture + \".outTransparency\") ($material + \".transparency\");\n        $count++;\n    }\n    // depth peeling: transparent faces are sorted correctly in the viewport\n    setAttr \"hardwareRenderingGlobals.transparencyAlgorithm\" 3;\n    print (\"AlphaNodeCorrect: \" + $count + \" of \" + size($materials) + \" materials changed\" + $where + \"\\n\");\n    return $count;\n}\nundoInfo -openChunk;\ncatch(ModelUtilities_AlphaNodeCorrect());\nundoInfo -closeChunk;"
        -sourceType "mel"
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -enable 1
        -width 35
        -height 35
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "TransparencyCorrect: Make alpha channels work properly for imported models by setting 'alpha is luminance' to false.\nUse this when the entire model is more or less see-through, it will make the correct parts of the model opaque as they should be."
        -enableBackground 0
        -backgroundColor 0 0 0
        -highlightColor 0.321569 0.521569 0.65098
        -align "center"
        -label "TransparencyCorrect"
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont"
        -imageOverlayLabel "TransparencyCorrect"
        -overlayLabelColor 0.8 0.8 0.8
        -overlayLabelBackColor 0 0 0 0.5
        -image "commandButton.png"
        -image1 "commandButton.png"
        -style "iconOnly"
        -marginWidth 1
        -marginHeight 1
        -command "global proc int ModelUtilities_TransparencyCorrect()\n{\n    // which objects to change: \"all\" (the whole scene) or \"selected\" (only the selected objects),\n    // set with the Options button\n    string $affect = \"all\";\n    if (`optionVar -exists \"ModelUtilities_affect\"`)\n        $affect = `optionVar -query \"ModelUtilities_affect\"`;\n    string $where = \"\";\n    if ($affect == \"selected\")\n        $where = \" (selected objects only)\";\n    // the materials to change: every lambert-type material (lambert, phong, blinn...) of the scene,\n    // or only the ones assigned to the selected objects. Maya's default material \"lambert1\" is left alone.\n    string $materials[];\n    if ($affect == \"selected\")\n    {\n        string $selection[] = `ls -selection -objectsOnly`;\n        string $shapes[];\n        if (size($selection))\n            $shapes = `ls -dag -noIntermediate -type \"mesh\" $selection`;\n        string $shape;\n        for ($shape in $shapes)\n        {\n            string $shadingGroups[] = `listConnections -type \"shadingEngine\" $shape`;\n            string $shadingGroup;\n            for ($shadingGroup in $shadingGroups)\n            {\n                string $shaders[] = `listConnections -source true -destination false ($shadingGroup + \".surfaceShader\")`;\n                $materials = stringArrayCatenate($materials, $shaders);\n            }\n        }\n        if (size($materials))\n            $materials = `ls -type \"lambert\" $materials`;\n    }\n    else\n        $materials = `ls -type \"lambert\"`;\n    $materials = stringArrayRemoveDuplicates($materials);\n    $materials = stringArrayRemove({\"lambert1\"}, $materials);\n    // the file textures to change: all of them in the scene, or the ones used by the selected objects' materials\n    string $files[];\n    if ($affect == \"selected\")\n    {\n        if (size($materials))\n        {\n            string $history[] = `listHistory $materials`;\n            $files = `ls -type \"file\" $history`;\n        }\n    }\n    else\n        $files = `ls -type \"file\"`;\n    if (size($files) == 0)\n    {\n        warning (\"TransparencyCorrect: no file textures found\" + $where);\n        return 0;\n    }\n    string $file;\n    for ($file in $files)\n        setAttr ($file + \".alphaIsLuminance\") 0;\n    // depth peeling: transparent faces are sorted correctly in the viewport\n    setAttr \"hardwareRenderingGlobals.transparencyAlgorithm\" 3;\n    print (\"TransparencyCorrect: \" + size($files) + \" textures changed\" + $where + \"\\n\");\n    return size($files);\n}\nundoInfo -openChunk;\ncatch(ModelUtilities_TransparencyCorrect());\nundoInfo -closeChunk;"
        -sourceType "mel"
        -commandRepeatable 1
        -flat 1
    ;
    separator
        -enable 1
        -width 12
        -height 35
        -manage 1
        -visible 1
        -preventOverride 0
        -enableBackground 0
        -backgroundColor 0 0 0
        -highlightColor 0.321569 0.521569 0.65098
        -style "shelf"
        -horizontal 0
    ;
    shelfButton
        -enableCommandRepeat 1
        -enable 1
        -width 35
        -height 35
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "UnfilterAllTextures: Sets every image texture to be unfiltered (ie: aliased, pixelated)"
        -enableBackground 0
        -backgroundColor 0 0 0
        -highlightColor 0.321569 0.521569 0.65098
        -align "center"
        -label "UnfilterAllTextures"
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont"
        -imageOverlayLabel "UnfilterAllTextures"
        -overlayLabelColor 0.8 0.8 0.8
        -overlayLabelBackColor 0 0 0 0.5
        -image "texturePlacement.png"
        -image1 "texturePlacement.png"
        -style "iconOnly"
        -marginWidth 1
        -marginHeight 1
        -command "global proc int ModelUtilities_UnfilterAllTextures()\n{\n    // which objects to change: \"all\" (the whole scene) or \"selected\" (only the selected objects),\n    // set with the Options button\n    string $affect = \"all\";\n    if (`optionVar -exists \"ModelUtilities_affect\"`)\n        $affect = `optionVar -query \"ModelUtilities_affect\"`;\n    string $where = \"\";\n    if ($affect == \"selected\")\n        $where = \" (selected objects only)\";\n    // the materials to change: every lambert-type material (lambert, phong, blinn...) of the scene,\n    // or only the ones assigned to the selected objects. Maya's default material \"lambert1\" is left alone.\n    string $materials[];\n    if ($affect == \"selected\")\n    {\n        string $selection[] = `ls -selection -objectsOnly`;\n        string $shapes[];\n        if (size($selection))\n            $shapes = `ls -dag -noIntermediate -type \"mesh\" $selection`;\n        string $shape;\n        for ($shape in $shapes)\n        {\n            string $shadingGroups[] = `listConnections -type \"shadingEngine\" $shape`;\n            string $shadingGroup;\n            for ($shadingGroup in $shadingGroups)\n            {\n                string $shaders[] = `listConnections -source true -destination false ($shadingGroup + \".surfaceShader\")`;\n                $materials = stringArrayCatenate($materials, $shaders);\n            }\n        }\n        if (size($materials))\n            $materials = `ls -type \"lambert\" $materials`;\n    }\n    else\n        $materials = `ls -type \"lambert\"`;\n    $materials = stringArrayRemoveDuplicates($materials);\n    $materials = stringArrayRemove({\"lambert1\"}, $materials);\n    // the file textures to change: all of them in the scene, or the ones used by the selected objects' materials\n    string $files[];\n    if ($affect == \"selected\")\n    {\n        if (size($materials))\n        {\n            string $history[] = `listHistory $materials`;\n            $files = `ls -type \"file\" $history`;\n        }\n    }\n    else\n        $files = `ls -type \"file\"`;\n    if (size($files) == 0)\n    {\n        warning (\"UnfilterAllTextures: no file textures found\" + $where);\n        return 0;\n    }\n    string $file;\n    for ($file in $files)\n        setAttr ($file + \".filterType\") 0;\n    print (\"UnfilterAllTextures: \" + size($files) + \" textures unfiltered\" + $where + \"\\n\");\n    return size($files);\n}\nundoInfo -openChunk;\ncatch(ModelUtilities_UnfilterAllTextures());\nundoInfo -closeChunk;"
        -sourceType "mel"
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -enable 1
        -width 35
        -height 35
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "FilterAllTextures: Sets every image texture to be filtered (smooth): quadratic filtering by default,\nthe filter type can be changed with the Options button (Mipmap, Box, Quadratic, Quartic, Gaussian)."
        -enableBackground 0
        -backgroundColor 0 0 0
        -highlightColor 0.321569 0.521569 0.65098
        -align "center"
        -label "FilterAllTextures"
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont"
        -imageOverlayLabel "FilterAllTextures"
        -overlayLabelColor 0.8 0.8 0.8
        -overlayLabelBackColor 0 0 0 0.5
        -image "texturePlacement.png"
        -image1 "texturePlacement.png"
        -style "iconOnly"
        -marginWidth 1
        -marginHeight 1
        -command "global proc int ModelUtilities_FilterAllTextures()\n{\n    // filter type: 1 Mipmap, 2 Box, 3 Quadratic, 4 Quartic, 5 Gaussian (set with the Options button)\n    int $filterType = 3;\n    if (`optionVar -exists \"ModelUtilities_filterType\"`)\n        $filterType = `optionVar -query \"ModelUtilities_filterType\"`;\n    // which objects to change: \"all\" (the whole scene) or \"selected\" (only the selected objects),\n    // set with the Options button\n    string $affect = \"all\";\n    if (`optionVar -exists \"ModelUtilities_affect\"`)\n        $affect = `optionVar -query \"ModelUtilities_affect\"`;\n    string $where = \"\";\n    if ($affect == \"selected\")\n        $where = \" (selected objects only)\";\n    // the materials to change: every lambert-type material (lambert, phong, blinn...) of the scene,\n    // or only the ones assigned to the selected objects. Maya's default material \"lambert1\" is left alone.\n    string $materials[];\n    if ($affect == \"selected\")\n    {\n        string $selection[] = `ls -selection -objectsOnly`;\n        string $shapes[];\n        if (size($selection))\n            $shapes = `ls -dag -noIntermediate -type \"mesh\" $selection`;\n        string $shape;\n        for ($shape in $shapes)\n        {\n            string $shadingGroups[] = `listConnections -type \"shadingEngine\" $shape`;\n            string $shadingGroup;\n            for ($shadingGroup in $shadingGroups)\n            {\n                string $shaders[] = `listConnections -source true -destination false ($shadingGroup + \".surfaceShader\")`;\n                $materials = stringArrayCatenate($materials, $shaders);\n            }\n        }\n        if (size($materials))\n            $materials = `ls -type \"lambert\" $materials`;\n    }\n    else\n        $materials = `ls -type \"lambert\"`;\n    $materials = stringArrayRemoveDuplicates($materials);\n    $materials = stringArrayRemove({\"lambert1\"}, $materials);\n    // the file textures to change: all of them in the scene, or the ones used by the selected objects' materials\n    string $files[];\n    if ($affect == \"selected\")\n    {\n        if (size($materials))\n        {\n            string $history[] = `listHistory $materials`;\n            $files = `ls -type \"file\" $history`;\n        }\n    }\n    else\n        $files = `ls -type \"file\"`;\n    if (size($files) == 0)\n    {\n        warning (\"FilterAllTextures: no file textures found\" + $where);\n        return 0;\n    }\n    string $file;\n    for ($file in $files)\n        setAttr ($file + \".filterType\") $filterType;\n    print (\"FilterAllTextures: \" + size($files) + \" textures filtered\" + $where + \"\\n\");\n    return size($files);\n}\nundoInfo -openChunk;\ncatch(ModelUtilities_FilterAllTextures());\nundoInfo -closeChunk;"
        -sourceType "mel"
        -commandRepeatable 1
        -flat 1
    ;
    separator
        -enable 1
        -width 12
        -height 35
        -manage 1
        -visible 1
        -preventOverride 0
        -enableBackground 0
        -backgroundColor 0 0 0
        -highlightColor 0.321569 0.521569 0.65098
        -style "shelf"
        -horizontal 0
    ;
    shelfButton
        -enableCommandRepeat 1
        -enable 1
        -width 35
        -height 35
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "MirrorAllTextureUVs: Make it so all UV nodes have U & V mirrored texture space"
        -enableBackground 0
        -backgroundColor 0 0 0
        -highlightColor 0.321569 0.521569 0.65098
        -align "center"
        -label "MirrorAllTextureUVs"
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont"
        -imageOverlayLabel "MirrorAllTextureUVs"
        -overlayLabelColor 0.8 0.8 0.8
        -overlayLabelBackColor 0 0 0 0.5
        -image "UVEditorUV.png"
        -image1 "UVEditorUV.png"
        -style "iconOnly"
        -marginWidth 1
        -marginHeight 1
        -command "global proc int ModelUtilities_MirrorAllTextureUVs()\n{\n    // which objects to change: \"all\" (the whole scene) or \"selected\" (only the selected objects),\n    // set with the Options button\n    string $affect = \"all\";\n    if (`optionVar -exists \"ModelUtilities_affect\"`)\n        $affect = `optionVar -query \"ModelUtilities_affect\"`;\n    string $where = \"\";\n    if ($affect == \"selected\")\n        $where = \" (selected objects only)\";\n    // the materials to change: every lambert-type material (lambert, phong, blinn...) of the scene,\n    // or only the ones assigned to the selected objects. Maya's default material \"lambert1\" is left alone.\n    string $materials[];\n    if ($affect == \"selected\")\n    {\n        string $selection[] = `ls -selection -objectsOnly`;\n        string $shapes[];\n        if (size($selection))\n            $shapes = `ls -dag -noIntermediate -type \"mesh\" $selection`;\n        string $shape;\n        for ($shape in $shapes)\n        {\n            string $shadingGroups[] = `listConnections -type \"shadingEngine\" $shape`;\n            string $shadingGroup;\n            for ($shadingGroup in $shadingGroups)\n            {\n                string $shaders[] = `listConnections -source true -destination false ($shadingGroup + \".surfaceShader\")`;\n                $materials = stringArrayCatenate($materials, $shaders);\n            }\n        }\n        if (size($materials))\n            $materials = `ls -type \"lambert\" $materials`;\n    }\n    else\n        $materials = `ls -type \"lambert\"`;\n    $materials = stringArrayRemoveDuplicates($materials);\n    $materials = stringArrayRemove({\"lambert1\"}, $materials);\n    // the texture placement (place2dTexture) nodes to change: all of them in the scene, or the ones used by the selected objects' materials\n    string $placements[];\n    if ($affect == \"selected\")\n    {\n        if (size($materials))\n        {\n            string $history[] = `listHistory $materials`;\n            $placements = `ls -type \"place2dTexture\" $history`;\n        }\n    }\n    else\n        $placements = `ls -type \"place2dTexture\"`;\n    if (size($placements) == 0)\n    {\n        warning (\"MirrorAllTextureUVs: no texture placement (place2dTexture) nodes found\" + $where);\n        return 0;\n    }\n    string $placement;\n    for ($placement in $placements)\n    {\n        setAttr ($placement + \".mirrorU\") 1;\n        setAttr ($placement + \".mirrorV\") 1;\n    }\n    print (\"MirrorAllTextureUVs: \" + size($placements) + \" textures mirrored\" + $where + \"\\n\");\n    return size($placements);\n}\nundoInfo -openChunk;\ncatch(ModelUtilities_MirrorAllTextureUVs());\nundoInfo -closeChunk;"
        -sourceType "mel"
        -commandRepeatable 1
        -flat 1
    ;
    shelfButton
        -enableCommandRepeat 1
        -enable 1
        -width 35
        -height 35
        -manage 1
        -visible 1
        -preventOverride 0
        -annotation "UnMirrorAllTextureUVs: Make all UV nodes have U & V mirroring set to false"
        -enableBackground 0
        -backgroundColor 0 0 0
        -highlightColor 0.321569 0.521569 0.65098
        -align "center"
        -label "UnMirrorAllTextureUVs"
        -labelOffset 0
        -rotation 0
        -flipX 0
        -flipY 0
        -useAlpha 1
        -font "plainLabelFont"
        -imageOverlayLabel "UnMirrorAllTextureUVs"
        -overlayLabelColor 0.8 0.8 0.8
        -overlayLabelBackColor 0 0 0 0.5
        -image "UVEditorUV.png"
        -image1 "UVEditorUV.png"
        -style "iconOnly"
        -marginWidth 1
        -marginHeight 1
        -command "global proc int ModelUtilities_UnMirrorAllTextureUVs()\n{\n    // which objects to change: \"all\" (the whole scene) or \"selected\" (only the selected objects),\n    // set with the Options button\n    string $affect = \"all\";\n    if (`optionVar -exists \"ModelUtilities_affect\"`)\n        $affect = `optionVar -query \"ModelUtilities_affect\"`;\n    string $where = \"\";\n    if ($affect == \"selected\")\n        $where = \" (selected objects only)\";\n    // the materials to change: every lambert-type material (lambert, phong, blinn...) of the scene,\n    // or only the ones assigned to the selected objects. Maya's default material \"lambert1\" is left alone.\n    string $materials[];\n    if ($affect == \"selected\")\n    {\n        string $selection[] = `ls -selection -objectsOnly`;\n        string $shapes[];\n        if (size($selection))\n            $shapes = `ls -dag -noIntermediate -type \"mesh\" $selection`;\n        string $shape;\n        for ($shape in $shapes)\n        {\n            string $shadingGroups[] = `listConnections -type \"shadingEngine\" $shape`;\n            string $shadingGroup;\n            for ($shadingGroup in $shadingGroups)\n            {\n                string $shaders[] = `listConnections -source true -destination false ($shadingGroup + \".surfaceShader\")`;\n                $materials = stringArrayCatenate($materials, $shaders);\n            }\n        }\n        if (size($materials))\n            $materials = `ls -type \"lambert\" $materials`;\n    }\n    else\n        $materials = `ls -type \"lambert\"`;\n    $materials = stringArrayRemoveDuplicates($materials);\n    $materials = stringArrayRemove({\"lambert1\"}, $materials);\n    // the texture placement (place2dTexture) nodes to change: all of them in the scene, or the ones used by the selected objects' materials\n    string $placements[];\n    if ($affect == \"selected\")\n    {\n        if (size($materials))\n        {\n            string $history[] = `listHistory $materials`;\n            $placements = `ls -type \"place2dTexture\" $history`;\n        }\n    }\n    else\n        $placements = `ls -type \"place2dTexture\"`;\n    if (size($placements) == 0)\n    {\n        warning (\"UnMirrorAllTextureUVs: no texture placement (place2dTexture) nodes found\" + $where);\n        return 0;\n    }\n    string $placement;\n    for ($placement in $placements)\n    {\n        setAttr ($placement + \".mirrorU\") 0;\n        setAttr ($placement + \".mirrorV\") 0;\n    }\n    print (\"UnMirrorAllTextureUVs: \" + size($placements) + \" textures unmirrored\" + $where + \"\\n\");\n    return size($placements);\n}\nundoInfo -openChunk;\ncatch(ModelUtilities_UnMirrorAllTextureUVs());\nundoInfo -closeChunk;"
