// HideVertexColors
// Make all objects hide their polygon vertex colors
global proc int ModelUtilities_HideVertexColors()
{
    // which objects to change: "all" (the whole scene) or "selected" (only the selected objects),
    // set with the Options button
    string $affect = "all";
    if (`optionVar -exists "ModelUtilities_affect"`)
        $affect = `optionVar -query "ModelUtilities_affect"`;
    string $where = "";
    if ($affect == "selected")
        $where = " (selected objects only)";
    // the meshes to change: all of them in the scene, or the selected ones
    string $meshes[];
    if ($affect == "selected")
    {
        string $selection[] = `ls -selection -objectsOnly`;
        if (size($selection))
            $meshes = `ls -long -dag -noIntermediate -type "mesh" $selection`;
    }
    else
        $meshes = `ls -long -noIntermediate -type "mesh"`;
    $meshes = stringArrayRemoveDuplicates($meshes);
    if (size($meshes) == 0)
    {
        warning ("HideVertexColors: no meshes found" + $where);
        return 0;
    }
    string $mesh;
    for ($mesh in $meshes)
        setAttr ($mesh + ".displayColors") 0;
    print ("HideVertexColors: " + size($meshes) + " meshes" + $where + "\n");
    return size($meshes);
}
undoInfo -openChunk;
catch(ModelUtilities_HideVertexColors());
undoInfo -closeChunk;
